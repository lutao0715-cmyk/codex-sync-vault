# fastwhisper 服务端地址（优先级最高）
FASTWHISPER_SERVER_URL=http://127.0.0.1:8000

# 或使用 IP + 端口（当未设置 FASTWHISPER_SERVER_URL 时生效）
# FASTWHISPER_SERVER_IP=127.0.0.1
# FASTWHISPER_SERVER_PORT=8000

# 可选：服务端请求超时（秒）
# FASTWHISPER_SERVER_TIMEOUT=600

# 可选：百度 API Key 和 Secret Key（当使用百度语音识别时需要）
# BAIDU_API_KEY=your_api_key
# BAIDU_SECRET_KEY=your_secret_key